{
	"easycom": {
		"^u-(.*)": "uview-ui/components/u-$1/u-$1.vue",
		"qiun-data-charts": "@/pkg-statistics/statistics/qiun-data-charts/components/qiun-data-charts/qiun-data-charts.vue"
	},
	"pages": [{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "首页",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/my/my",
			"style": {
				"navigationBarTitleText": "我的"
			}
		}
	],
	"subPackages": [{
			"root": "pkg-group",
			"pages": [{
				"path": "index",
				"style": {
					"navigationBarTitleText": "群组"
				}
			}]
		},
		{
			"root": "pkg-login",
			"pages": [{
				"path": "login",
				"style": {
					"navigationBarTitleText": "登录",
					"disableScroll": true
				}
			}]
		},
		{
			"root": "pkg-profile",
			"pages": [{
				"path": "index",
				"style": {
					"navigationBarTitleText": "编辑资料"
				}
			}]
		},
		{
			"root": "pkg-password",
			"pages": [{
				"path": "index",
				"style": {
					"navigationBarTitleText": "修改密码"
				}
			}]
		},
		{
			"root": "pkg-statistics",
			"pages": [{
					"path": "statistics/pages/index",
					"style": {
						"navigationBarTitleText": "积分统计"
					}
				},
				{
					"path": "statistics/pages/leaderboard",
					"style": {
						"navigationBarTitleText": "排行榜"
					}
				},
				{
					"path": "statistics/pages/notifications",
					"style": {
						"navigationBarTitleText": "消息通知"
					}
				}
			]
		}
	],
	"globalStyle": {
		"pageOrientation": "portrait",
		"navigationBarTitleText": "雀圣小程序",
		"navigationBarTextStyle": "white",
		"navigationBarBackgroundColor": "#071A13",
		"backgroundColor": "#06120E",
		"backgroundColorTop": "#0A2018",
		"backgroundColorBottom": "#040C09"
	},
	"tabBar": {
		"color": "#7E9C8E",
		"selectedColor": "#34D399",
		"borderStyle": "black",
		"backgroundColor": "#0A1F17",
		"list": [{
				"pagePath": "pages/index/index",
				"iconPath": "static/tab/home_not_select.png",
				"selectedIconPath": "static/tab/home_select.png",
				"text": "首页"
			},
			{
				"pagePath": "pages/my/my",
				"iconPath": "static/tab/user_not_select.png",
				"selectedIconPath": "static/tab/user_select.png",
				"text": "我的"
			}
		]
	}
}